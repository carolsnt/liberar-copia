{
  "manifest_version": 3,
  "name": "Liberar Cópia",
  "version": "3.0",
  "description": "Remove bloqueios de cópia automaticamente.",

  "host_permissions": [
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}